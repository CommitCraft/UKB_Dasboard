# Frontend Dev Server Configuration
VITE_HOST=0.0.0.0
VITE_PORT=8800
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api

# Node-RED Backend Server Configuration
# Note: Vite injects these variables during build or startup.
# Whenever you update VITE_NODE_RED_HOST or VITE_NODE_RED_PORT,
# you MUST run 'npm run build' and restart PM2 ('npx pm2 restart all')
# for the new URL to take effect in the browser.
VITE_NODE_RED_HOST=192.168.1.99
VITE_NODE_RED_PORT=1881
VITE_NODE_RED_PROTOCOL=http
